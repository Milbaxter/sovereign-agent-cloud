NODE_ENV=production
PORT=3000
PORTAL_DOMAIN=account.example.com
PUBLIC_ORIGIN=https://account.example.com
TENANT_DOMAIN=agents.example.com
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_URL=postgres://sovereign:REPLACE_WITH_GENERATED_PASSWORD@postgres:5432/sovereign
BILLING_MODE=test
CHECKOUT_ENABLED=false
CREDITS_ENABLED=false
ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
HANDOFF_PRIVATE_KEY_FILE=secrets/handoff-private.pem
HANDOFF_PUBLIC_KEY_FILE=secrets/handoff-public.pem
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_HOSTING_PRICE_ID=
STRIPE_CREDIT_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false
SMTP_URL=
EMAIL_FROM=
UPCLOUD_TOKEN=
UPCLOUD_ZONE=fi-hel1
# Resolve the actual plan and Ubuntu 24.04 template IDs in your account; no guessed IDs.
UPCLOUD_PLAN=
UPCLOUD_TEMPLATE=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ZONE_ID=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.6-browser@sha256:62832668e3e5e139f745f7d3df892c9251eb53318b7d14a76c410dde1f25d730
# Run the image-publish workflow, then copy its immutable tag AND digest here.
TENANT_IMAGE=
ADMIN_SSH_PUBLIC_KEY=
ADMIN_CIDR=
# Use a Finnish S3 endpoint, a private bucket without versioning, and an operator age public key.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_AGE_RECIPIENT=
MODEL_CONFIG_FILE=models.json
RELEASE_EVIDENCE_FILE=release-evidence.json
SCALEWAY_API_KEY=
# Founding-account cap: paid members retain their place after cancellation.
MAX_TENANTS=50
