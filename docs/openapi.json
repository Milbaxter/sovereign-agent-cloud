    "/v1/chat/completions": {
      "post": {
        "summary": "Metered streaming or non-streaming chat with tool calls",
        "operationId": "post_v1_chat_completions",
        "responses": {
          "200": {
            "description": "OpenAI-compatible JSON or SSE stream; tool calls supported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin, ownership, or fresh login check failed"
          },
          "409": {
            "description": "Lifecycle conflict"
          },
          "503": {
            "description": "Launch gate closed or dependency unavailable"
          },
          "402": {
            "description": "Insufficient unreserved credit or outstanding debt"
          }
        },
        "security": [
          {
            "tenantKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                },
                "additionalProperties": true,
                "required": ["model", "messages"]
              }
            }
          }
        }
      }
    },
