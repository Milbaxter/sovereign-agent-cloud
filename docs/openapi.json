    "title": "Sovereign Agent Cloud",
    "version": "0.1.0",
    "description": "All browser POST requests require an Origin matching PUBLIC_ORIGIN. Wallet values are integer micro-euro strings. Session cookie is HttpOnly/Secure/SameSite=Strict. Upstream provider keys never enter this API."
  },
