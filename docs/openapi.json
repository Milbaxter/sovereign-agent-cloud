                    "type": "string",
                    "format": "email"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["byok", "credits"],
                    "description": "Optional inference preselection carried into the email sign-in link. Confirm provider and location before checkout."
                  }
                },
                "additionalProperties": false,
                "required": ["email"]
              }
            }
          }
