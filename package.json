{
  "name": "sovereign-agent-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "preflight": "tsx scripts/preflight.ts",
    "format": "prettier --write src tests scripts public tenant-public docs/openapi.json",
    "format:check": "prettier --check src tests scripts public tenant-public docs/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/lib-storage": "^3.1139.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
